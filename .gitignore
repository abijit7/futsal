.DS_Store

# Backend build output
backend/target/

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Uploaded venue images are runtime data, not source. In production app.upload.dir points at
# persistent storage outside the repository.
uploads/

# Local environment files
.env
.env.*
frontend/.env
frontend/.env.*

# JetBrains IDE state. The whole directory is local machine config, not source; a
# partial ignore list previously let .idea/copilotDiffState.xml through with a live
# database password in it.
.idea/
