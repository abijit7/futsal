<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static entry points only. Individual venue pages (/venues/:id) are database-driven, so if
  they are worth indexing this file should be generated at build or served by the API rather
  than hand-maintained here.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://YOUR_FRONTEND_DOMAIN/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://YOUR_FRONTEND_DOMAIN/venues</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://YOUR_FRONTEND_DOMAIN/register</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
</urlset>
