# Copy these values into Azure Key Vault and reference them from App Service / Container Apps
# application settings. Do not commit a real .env file with production secrets.

SPRING_PROFILES_ACTIVE=prod

# Port. Azure App Service on Linux expects 8080 by default; Container Apps injects its own PORT.
PORT=8080

# Azure Database for MySQL Flexible Server. TLS is mandatory - a URL with useSSL=false is
# rejected by the server.
DB_URL=jdbc:mysql://YOUR_SERVER.mysql.database.azure.com:3306/YOUR_DB_NAME?useSSL=true&requireSSL=true&sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# API security. Both must be at least 32 bytes, and must differ from each other.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MINUTES=1440
JWT_ISSUER=merofutsal-production
VERIFICATION_SECRET=replace-with-a-different-32-byte-random-secret

# Frontend origin allowed to call the API. Exactly the real origin - the API sends
# Access-Control-Allow-Credentials, so a "*" wildcard is rejected by browsers at runtime.
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN

# Rate limiting (per client IP). The credential bucket covers login, register and password reset.
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_TOKENS=60
RATE_LIMIT_REFILL_MINUTES=1
RATE_LIMIT_CREDENTIAL_CAPACITY=10
RATE_LIMIT_CREDENTIAL_REFILL_TOKENS=10
RATE_LIMIT_CREDENTIAL_REFILL_MINUTES=15

# Uploads. The App Service / Container Apps filesystem is EPHEMERAL and is not shared between
# instances, so this MUST point at a mounted Azure Files share or uploaded venue images vanish on
# every restart, redeploy and scale-out.
UPLOAD_DIR=/mnt/merofutsal/uploads
UPLOAD_MAX_IMAGE_SIZE_BYTES=5242880
UPLOAD_MAX_IMAGE_DIMENSION=5000
UPLOAD_MAX_IMAGE_FILES=10

# Payment gateways.
# eSewa uses an HMAC-signed form POST; Khalti is API-first with a server-side lookup.
PAYMENT_ESEWA_MERCHANT_CODE=YOUR_ESEWA_MERCHANT_CODE
PAYMENT_ESEWA_MERCHANT_SECRET=YOUR_ESEWA_MERCHANT_SECRET
PAYMENT_ESEWA_FORM_URL=https://epay.esewa.com.np/api/epay/main/v2/form
PAYMENT_ESEWA_STATUS_URL=https://epay.esewa.com.np/api/epay/transaction/status/
PAYMENT_KHALTI_SECRET=YOUR_KHALTI_LIVE_SECRET_KEY
PAYMENT_KHALTI_API_URL=https://khalti.com/api/v2

# Where the gateways send the browser back. Must be the public frontend origin; the server builds
# success_url/failure_url from this rather than trusting the client.
PAYMENT_RETURN_BASE_URL=https://YOUR_FRONTEND_DOMAIN

# How long an unfinished checkout may hold a slot before the sweep releases it.
PAYMENT_HOLD_MINUTES=60
PAYMENT_SWEEP_INTERVAL_MS=300000

# Email verification and password reset delivery
VERIFICATION_EMAIL_ENABLED=true
VERIFICATION_EMAIL_FROM=no-reply@YOUR_DOMAIN
SPRING_MAIL_HOST=smtp.YOUR_PROVIDER.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=YOUR_SMTP_USERNAME
SPRING_MAIL_PASSWORD=YOUR_SMTP_PASSWORD
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true

# Optional SMS verification delivery. Leave blank if phone verification is not used.
SMS_WEBHOOK_URL=

# Operational settings
APP_TIME_ZONE=Asia/Kathmandu
MAIL_HEALTH_ENABLED=false

# Admin bootstrap. Set once for the first deploy, then remove - the app updates the account's
# role and password on every start while these are present.
# ADMIN_EMAIL=
# ADMIN_PASS=
