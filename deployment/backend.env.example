# Copy these values into your production host secret manager.
# Do not commit a real .env file with production secrets.

SPRING_PROFILES_ACTIVE=prod

# MySQL
DB_URL=jdbc:mysql://YOUR_DB_HOST:3306/YOUR_DB_NAME?useSSL=true&serverTimezone=UTC
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

# API security
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MINUTES=1440
JWT_ISSUER=merofutsal-production
VERIFICATION_SECRET=replace-with-a-different-32-byte-random-secret

# Frontend origin allowed to call the API
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN

# Persistent upload storage path mounted by the host/container
UPLOAD_DIR=/var/lib/merofutsal/uploads
UPLOAD_MAX_IMAGE_SIZE_BYTES=5242880
UPLOAD_MAX_IMAGE_DIMENSION=5000
UPLOAD_MAX_IMAGE_FILES=10

# Payment gateways
PAYMENT_ESEWA_MERCHANT_CODE=YOUR_ESEWA_MERCHANT_CODE
PAYMENT_ESEWA_MERCHANT_SECRET=YOUR_ESEWA_MERCHANT_SECRET
PAYMENT_ESEWA_API_URL=https://YOUR_ESEWA_PAYMENT_ENDPOINT
PAYMENT_KHALTI_SECRET=YOUR_KHALTI_SECRET_KEY
PAYMENT_KHALTI_PUBLIC_KEY=YOUR_KHALTI_PUBLIC_KEY
PAYMENT_KHALTI_API_URL=https://YOUR_KHALTI_API_BASE_URL

# Email verification and password reset delivery
VERIFICATION_EMAIL_ENABLED=true
VERIFICATION_EMAIL_FROM=no-reply@YOUR_DOMAIN
SPRING_MAIL_HOST=smtp.YOUR_PROVIDER.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=YOUR_SMTP_USERNAME
SPRING_MAIL_PASSWORD=YOUR_SMTP_PASSWORD
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true

# Optional SMS verification delivery. Leave blank if phone verification is not used in production.
SMS_WEBHOOK_URL=

# Operational settings
APP_TIME_ZONE=Asia/Kathmandu
MAIL_HEALTH_ENABLED=false
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
